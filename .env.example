# Enlace de la hoja que se procesará. Tiene prioridad sobre GOOGLE_SHEET_ID.
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/ID_DE_LA_HOJA/edit
# También se puede usar directamente el ID si no se configura la URL.
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=./utopian-calling-274800-552c65952619.json
# Credenciales de la tienda. No guardar valores reales en este archivo de ejemplo.
STORE_USERNAME=
STORE_PASSWORD=
STORE_LOGIN_URL=https://www.mtgmintcard.com/login
STORE_USERNAME_SELECTOR=
STORE_PASSWORD_SELECTOR=
STORE_LOGIN_SUBMIT_SELECTOR=
# El navegador se muestra si se configura como true. También se activa automáticamente
# cuando STORE_SOLVE_CHALLENGE=true.
STORE_HEADED=false
STORE_RETRY_DELAY=5
STORE_SOLVE_CHALLENGE=false
STORE_AUTH_FILE=playwright/.auth/store.json
